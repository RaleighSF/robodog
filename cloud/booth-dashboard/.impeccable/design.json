  "components": [
    {
      "name": "Synoptic Page Keys",
      "kind": "nav",
      "refersTo": "page-key",
      "description": "Vertical EICAS page keys; selected key filled with the cloud accent.",
      "html": "<nav class=\"ds-keys\"><button class=\"ds-key ds-on\" aria-pressed=\"true\">POWER</button><button class=\"ds-key\">GAIT</button><button class=\"ds-key\">ATTITUDE</button></nav>",
      "css": ":host{--u:12px;--bg-base:#0B0E12;--surface-1:#111519;--surface-2:#161B21;--surface-inset:#0A0D10;--border-subtle:#1E262E;--border:#2C363F;--border-strong:#4A5A68;--bevel-top:rgba(255,255,255,.06);--text-primary:#E6EDF3;--text-secondary:#9FB0C0;--text-tertiary:#8494A3;--status-ok:#3FD68C;--status-warn:#FFB224;--status-danger:#FF5C5C;--accent:#3A9BF0;--accent-ink:#06121F;--focus:#7DF0FF;}.ds-keys{display:flex;flex-direction:column;gap:calc(var(--u)*.25);background:var(--surface-1);padding:12px}.ds-key{font-family:'Chakra Petch',sans-serif;font-weight:600;letter-spacing:.08em;font-size:calc(var(--u)*1.05);color:var(--text-secondary);background:var(--surface-2);border:1px solid var(--border);border-radius:2px;text-align:left;padding:calc(var(--u)*.32) calc(var(--u)*.9);min-width:calc(var(--u)*9);cursor:pointer;box-shadow:inset 0 1px 0 var(--bevel-top),inset 0 -2px 0 rgba(0,0,0,.35)}.ds-key:not(.ds-on):hover{border-color:var(--border-strong);color:var(--text-primary)}.ds-key:focus-visible{outline:2px solid var(--focus);outline-offset:2px}.ds-key.ds-on{color:var(--accent-ink);background:var(--accent);border-color:var(--accent);box-shadow:inset 0 -2px 0 rgba(0,0,0,.25)}"
    },
    {
      "name": "Master Annunciators",
      "kind": "button",
      "refersTo": "annunciator-caution-lit",
      "description": "MASTER WARNING / CAUTION; latch on unacknowledged findings, WARNING flashes 1 Hz.",
      "html": "<div class=\"ds-annuns\"><button class=\"ds-annun ds-warning ds-lit\"><span class=\"ds-t\">MASTER</span><span class=\"ds-big\">WARNING</span></button><button class=\"ds-annun ds-caution ds-lit\"><span class=\"ds-t\">MASTER</span><span class=\"ds-big\">CAUTION</span></button><button class=\"ds-annun\"><span class=\"ds-t\">MASTER</span><span class=\"ds-big\">CAUTION</span></button></div>",
      "css": ":host{--u:12px;--bg-base:#0B0E12;--surface-1:#111519;--surface-2:#161B21;--surface-inset:#0A0D10;--border-subtle:#1E262E;--border:#2C363F;--border-strong:#4A5A68;--bevel-top:rgba(255,255,255,.06);--text-primary:#E6EDF3;--text-secondary:#9FB0C0;--text-tertiary:#8494A3;--status-ok:#3FD68C;--status-warn:#FFB224;--status-danger:#FF5C5C;--accent:#3A9BF0;--accent-ink:#06121F;--focus:#7DF0FF;}.ds-annuns{display:flex;gap:calc(var(--u)*.8);background:var(--surface-1);padding:12px}.ds-annun{display:grid;place-items:center;min-width:calc(var(--u)*10);padding:calc(var(--u)*.45) calc(var(--u)*1);border:1px solid var(--border);border-radius:4px;background:var(--surface-inset);color:var(--text-tertiary);font:inherit}.ds-t{font-family:'Chakra Petch',sans-serif;text-transform:uppercase;letter-spacing:.08em;font-weight:600;font-size:calc(var(--u)*.9)}.ds-big{font-family:'Chakra Petch',sans-serif;font-weight:700;letter-spacing:.08em;font-size:calc(var(--u)*1.6);line-height:1.05}.ds-lit.ds-warning{background:var(--status-danger);color:#1A0505;border-color:var(--status-danger);cursor:pointer;animation:ds-flash 1s steps(2,jump-none) infinite}.ds-lit.ds-caution{background:var(--status-warn);color:#0B0E12;border-color:var(--status-warn);cursor:pointer}.ds-annun:focus-visible{outline:2px solid var(--focus);outline-offset:2px}@keyframes ds-flash{50%{background:var(--surface-inset);color:var(--status-danger)}}@media (prefers-reduced-motion:reduce){.ds-lit.ds-warning{animation:none}}"
    },
    {
      "name": "Freshness Lamp",
